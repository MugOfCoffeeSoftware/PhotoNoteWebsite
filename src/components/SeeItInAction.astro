---
interface Props {
  lang: "en" | "de";
  t: {
    eyebrow: string;
    heading: string;
    linkLabel: string;
    warningTitle: string;
    warningBody: string;
    cancel: string;
    continue: string;
  };
}

const { lang, t } = Astro.props;
const playlistUrls = {
  de: "https://www.youtube.com/playlist?list=PLCSoyID9cizE",
  en: "https://www.youtube.com/playlist?list=PLwzsOtAyEliok4I0BB0-ZjxYRjWwmAhKO",
};
const playlistUrl = playlistUrls[lang];
---

<section class="section videos-section">
  <div class="container inner">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{t.heading}</h2>
    <a class="btn btn-primary playlist-link" href={playlistUrl} rel="external">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21.58 7.19a2.86 2.86 0 0 0-2.01-2.02C17.79 4.7 12 4.7 12 4.7s-5.79 0-7.57.47A2.86 2.86 0 0 0 2.42 7.2 29.8 29.8 0 0 0 1.95 12c0 1.62.14 3.23.47 4.81a2.86 2.86 0 0 0 2.01 2.02c1.78.47 7.57.47 7.57.47s5.79 0 7.57-.47a2.86 2.86 0 0 0 2.01-2.02c.33-1.58.47-3.19.47-4.81 0-1.62-.14-3.23-.47-4.81ZM9.99 15.12V8.88L15.22 12l-5.23 3.12Z" />
      </svg>
      {t.linkLabel}
    </a>
  </div>

  <dialog class="external-link-dialog" aria-labelledby="youtube-warning-title">
    <div class="dialog-content">
      <h3 id="youtube-warning-title">{t.warningTitle}</h3>
      <p>{t.warningBody}</p>
      <div class="dialog-actions">
        <button class="btn btn-ghost cancel-button" type="button">{t.cancel}</button>
        <a class="btn btn-primary" href={playlistUrl} rel="external">{t.continue}</a>
      </div>
    </div>
  </dialog>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".videos-section");
  const playlistLink = section?.querySelector<HTMLAnchorElement>(".playlist-link");
  const dialog = section?.querySelector<HTMLDialogElement>(".external-link-dialog");
  const cancelButton = dialog?.querySelector<HTMLButtonElement>(".cancel-button");

  if (playlistLink && dialog && cancelButton) {
    playlistLink.addEventListener("click", (event) => {
      event.preventDefault();
      dialog.showModal();
    });
    cancelButton.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .videos-section {
    padding-top: clamp(36px, 5vw, 64px);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .eyebrow {
    margin-bottom: 0.25em;
  }

  h2 {
    margin-bottom: 0.35em;
  }

  .playlist-link svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  .external-link-dialog {
    width: min(480px, calc(100vw - 32px));
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    color: var(--ink);
    background: var(--card);
    box-shadow: 0 24px 64px rgba(30, 12, 50, 0.3);
  }

  .external-link-dialog::backdrop {
    background: rgba(30, 12, 50, 0.6);
  }

  .dialog-content {
    padding: clamp(24px, 5vw, 36px);
  }

  .dialog-content p {
    color: var(--ink-soft);
    margin-bottom: 24px;
  }

  .dialog-actions {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 12px;
  }

  button.btn {
    font-family: inherit;
    cursor: pointer;
  }

  @media (max-width: 480px) {
    .dialog-actions {
      flex-direction: column-reverse;
    }

    .dialog-actions .btn {
      justify-content: center;
    }
  }
</style>
