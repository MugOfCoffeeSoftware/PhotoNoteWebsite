---
import type { Locale } from "../i18n";

interface Props {
  lang: Locale;
  t: {
    links: { legal: string; privacy: string; support: string; contact: string };
    socials: { youtube: string; company: string };
    copyright: string;
    joke: string;
  };
}

const { lang, t } = Astro.props;
const year = new Date().getFullYear();
const copyright = t.copyright.replace("{year}", String(year));
---

<footer class="site-footer">
  <div class="container row">
    <div class="brand">
      <img src="/img/IconWithBorder.jpeg" alt="" width="32" height="32" />
      <span>PhotoNote</span>
      <span class="socials">
        <a
          href="https://www.youtube.com/@MugofCoffeeSoftwareGmbH"
          target="_blank"
          rel="noopener"
          aria-label={t.socials.youtube}
          class="icon-link"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/>
          </svg>
        </a>
        <a
          href="https://mugofcoffee.de"
          target="_blank"
          rel="noopener"
          aria-label={t.socials.company}
          class="icon-link"
        >
          <img src="/logo.svg" alt="" height="22" class="logo-icon" />
        </a>
      </span>
    </div>
    <nav>
      <a href={`/${lang}/legal-notice`}>{t.links.legal}</a>
      <a href={`/${lang}/privacy-policy`}>{t.links.privacy}</a>
      <a href="mailto:info@mugofcoffee.de?subject=PhotoNote">{t.links.contact}</a>
    </nav>
    <small>{copyright} <em class="joke">{t.joke}</em></small>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(63, 31, 102, 0.1);
    padding: 32px 0;
    background: var(--bg-soft);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
  }
  .brand {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--ink);
  }
  .brand img { border-radius: 7px; }
  nav { display: flex; align-items: center; gap: 22px; }
  nav a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  nav a:hover { color: var(--ink); }
  .socials {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-left: 10px;
    padding-left: 16px;
    border-left: 1px solid rgba(63, 31, 102, 0.15);
  }
  .icon-link {
    display: inline-flex;
    color: var(--ink-soft);
    transition: color 0.15s ease;
  }
  .icon-link:hover { color: var(--ink); }
  .logo-icon {
    height: 22px;
    width: auto;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }
  .icon-link:hover .logo-icon { opacity: 1; }
  small { color: var(--ink-mute); font-size: 0.85rem; }
</style>
