---
interface Props {
  variant?: "light" | "dark";
  t: {
    appStoreAriaLabel: string;
    appStoreSmall: string;
    appStoreName: string;
    googlePlayAriaLabel: string;
    googlePlaySmall: string;
    googlePlayName: string;
  };
}
const { variant = "light", t } = Astro.props;
---

<div class={`badges ${variant}`}>
  {/* TODO: replace href with real App Store URL */}
  <a class="badge" href="https://apps.apple.com/app/photonote-photo-with-info/id6770300032" aria-label={t.appStoreAriaLabel} data-umami-event="download-ios" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path fill="currentColor" d="M17.564 12.61c-.02-2.12 1.73-3.14 1.81-3.19-.99-1.44-2.53-1.64-3.07-1.66-1.31-.13-2.55.77-3.21.77-.66 0-1.69-.75-2.78-.73-1.43.02-2.74.83-3.48 2.11-1.48 2.56-.38 6.36 1.06 8.45.71 1.02 1.55 2.17 2.64 2.13 1.06-.04 1.46-.69 2.74-.69 1.28 0 1.64.69 2.76.66 1.14-.02 1.86-1.04 2.55-2.07.82-1.18 1.15-2.33 1.16-2.39-.03-.01-2.21-.85-2.23-3.39ZM15.39 6.27c.58-.71 1-1.69.88-2.68-.85.04-1.89.57-2.51 1.27-.55.62-1.04 1.62-.91 2.58.94.07 1.92-.48 2.54-1.17Z"/>
    </svg>
    <span class="badge-text">
      <small>{t.appStoreSmall}</small>
      <strong>{t.appStoreName}</strong>
    </span>
  </a>

  {/* TODO: replace href with real Google Play URL */}
  <a class="badge" href="https://play.google.com/store/apps/details?id=de.mugofcoffee.photonote" aria-label={t.googlePlayAriaLabel} data-umami-event="download-android" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path fill="currentColor" d="M3.6 2.3c-.4.3-.6.8-.6 1.4v16.6c0 .6.2 1.1.6 1.4l9.1-9.7L3.6 2.3Zm10.4 8.6 2.3-2.4-9.1-5.3c-.4-.2-.8-.3-1.1-.2l7.9 7.9Zm0 2.2-7.9 7.9c.3.1.7 0 1.1-.2l9.1-5.3-2.3-2.4Zm5.7-3.3-2.7-1.5-2.6 2.7 2.6 2.7 2.7-1.6c.7-.4.7-1.9 0-2.3Z"/>
    </svg>
    <span class="badge-text">
      <small>{t.googlePlaySmall}</small>
      <strong>{t.googlePlayName}</strong>
    </span>
  </a>
</div>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 12px;
    text-decoration: none;
    background: #1a1027;
    color: white;
    border: 1.5px solid #1a1027;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 6px 16px rgba(63, 31, 102, 0.18);
  }
  .badge:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(63, 31, 102, 0.28); }
  .badge-text { display: flex; flex-direction: column; line-height: 1.1; text-align: left; }
  .badge-text small { font-size: 0.7rem; opacity: 0.85; }
  .badge-text strong { font-size: 1.05rem; font-weight: 600; }
  .light .badge { background: white; color: var(--ink); border-color: rgba(63, 31, 102, 0.15); }
</style>
