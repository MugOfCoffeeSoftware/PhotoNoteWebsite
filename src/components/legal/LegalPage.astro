---
---

<main class="legal-page">
  <div class="container">
    <article class="legal-content">
      <slot />
    </article>
  </div>
</main>

<style>
  .legal-page {
    padding: clamp(28px, 5vw, 64px) 0 clamp(48px, 7vw, 96px);
  }
  .legal-content {
    max-width: 760px;
    margin-inline: auto;
  }
  .legal-content :global(h1),
  .legal-content :global(h2) {
    font-size: clamp(2rem, 3vw + 1rem, 3rem);
    line-height: 1.1;
  }
  .legal-content :global(h1) {
    margin: 0 0 0.6em;
  }
  .legal-content :global(h2) {
    margin: 1.6em 0 0.5em;
  }
  .legal-content :global(h3) {
    margin: 1.4em 0 0.4em;
    font-size: clamp(1.25rem, 0.9vw + 1rem, 1.55rem);
  }
  .legal-content :global(h4) {
    margin: 1.4em 0 0.3em;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
    letter-spacing: 0;
  }
  .legal-content :global(p) {
    color: var(--ink-soft);
  }
  .legal-content :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(63, 31, 102, 0.3);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s ease;
    word-break: break-word;
  }
  .legal-content :global(a:hover) {
    text-decoration-color: var(--ink);
  }
  .legal-content :global(.address) {
    margin: 0.4em 0 1.2em;
    padding: 14px 18px;
    background: var(--bg-soft);
    border-radius: 12px;
    border: 1px solid rgba(63, 31, 102, 0.08);
  }
  .legal-content :global(.address p) {
    margin: 0;
    color: var(--ink);
  }
  .legal-content :global(.updated) {
    margin-top: 2em;
    color: var(--ink-mute);
    font-size: 0.9rem;
  }
</style>
