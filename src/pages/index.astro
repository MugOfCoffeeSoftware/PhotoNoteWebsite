---
import { locales } from "../i18n";

const defaultLocale = "en";
const canonical = `${Astro.site?.toString().replace(/\/$/, "") ?? ""}/${defaultLocale}/`;
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <title>PhotoNote</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <script is:inline define:vars={{ supported: locales, defaultLocale }}>
      (function () {
        try {
          const langs = (navigator.languages && navigator.languages.length)
            ? navigator.languages
            : [navigator.language || ""];
          let target = defaultLocale;
          for (const tag of langs) {
            const primary = String(tag).toLowerCase().split("-")[0];
            if (supported.indexOf(primary) !== -1) { target = primary; break; }
          }
          location.replace("/" + target + "/");
        } catch (e) {
          location.replace("/" + defaultLocale + "/");
        }
      })();
    </script>
    <meta http-equiv="refresh" content={`0;url=/${defaultLocale}/`} />
  </head>
  <body>
    <a href={`/${defaultLocale}/`}>Continue to PhotoNote</a>
  </body>
</html>
